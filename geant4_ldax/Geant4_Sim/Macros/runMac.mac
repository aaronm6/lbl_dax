## ----------------------- ##
##      GENERIC Macro      ##
## ----------------------- ##

## ------------------------ ##
##       RUN CONTROL        ##
## ------------------------ ##
/run/verbose       0
/control/verbose   0
/tracking/verbose  0

## Turns on Atomic Deexcitation
/process/em/fluo true
/process/em/auger true
/process/em/augerCascade true
/process/em/pixe true
/process/em/deexcitationIgnoreCut true 

#/cuts/setLowEdge 10 eV
#/run/setCut 1 um

#set the random seeds
/random/setSeeds 420 69

## ------------------------ ##
##     SET DET PARAMS       ##
## ------------------------ ##

## What geometry setup to use 
## Options:  HydroX
/mydet/WhichGeometry HydroX

## Set dopant material: H2, He or None
/mydet/WhichDopant He

## Set dopant fraciton by mass
/mydet/DopantFraction 0.5

## ------------------------ ##
##   INITIALIZE DETECTOR    ##
## ALLOWS FOR MACRO EDITING ##
##      OF DET PARAMS       ##
## ------------------------ ##   

## Must be set before defining generator
/run/initialize

## Check for overlapping geometries
## must be after initialize
/geometry/test/run

## ------------------------ ##
##      VISUALIZATION       ##
## ------------------------ ##

